# Supabase (free) - create project at https://supabase.com, then paste:
# Project Settings > API > Project URL
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"

# Project Settings > API > anon public key
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Razorpay (India payments) - https://razorpay.com, Key ID for test mode
VITE_RAZORPAY_KEY_ID="YOUR_RAZORPAY_KEY_ID"

# WhatsApp number with country code, digits only (used for owner chat links)
VITE_OWNER_WHATSAPP="910000000000"

# Google Analytics 4 (optional) - Measurement ID like G-XXXXXXXXXX
VITE_GA_ID=""

# Gemini API key (optional) for AI horoscope generation.
# Also injected from AI Studio secrets as GEMINI_API_KEY at build time.
VITE_GEMINI_API_KEY=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
